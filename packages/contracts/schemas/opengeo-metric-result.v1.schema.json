{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opengeo.example/opengeo-metric-result.v1.schema.json",
  "title": "OpenGEO Metric Result v1",
  "type": "object",
  "required": [
    "metric_id",
    "metric_version",
    "value",
    "scope",
    "sample",
    "evidence_query"
  ],
  "properties": {
    "metric_id": {
      "type": "string"
    },
    "metric_version": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "sample": {
      "type": "object",
      "required": [
        "planned",
        "valid",
        "included",
        "excluded"
      ],
      "properties": {
        "planned": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "included": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evidence_query": {
      "type": "object"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
