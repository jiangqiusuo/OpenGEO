{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@sysiphus/contracts": ["packages/contracts/src/index.ts"],
      "@sysiphus/metrics": ["packages/metrics/src/index.ts"],
      "@sysiphus/client": ["packages/client/src/index.ts"],
      "@sysiphus/cli": ["packages/cli/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["**/dist/**", "node_modules"]
}
